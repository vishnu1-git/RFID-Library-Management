# Environment Configuration for LibraSync
PROJECT_NAME="LibraSync - Intelligent RFID-Enabled ILMS"
API_V1_STR=/api/v1
SECRET_KEY=librasync-enterprise-grade-secret-key-super-secure-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Primary PostgreSQL Configuration (via Docker Compose)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=librasync

# Optional direct connection string override:
# DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/librasync
# DATABASE_URL=sqlite:///./librasync.db

# Circulation & Fines
DEFAULT_BORROW_DAYS=14
MAX_BOOKS_PER_MEMBER=4
FINE_PER_DAY=2.0
MAX_OVERDUE_FINE_LIMIT=100.0

# RFID & Security Boundary
RFID_READER_TIMEOUT_SEC=3.0
GATE_ALARM_AUTO_DISARM_SEC=15
ILMS_ADAPTER_TYPE=mock
ILMS_ENDPOINT_URL=http://ilms.local:8080/ncip

